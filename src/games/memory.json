{
  "description": "Vocab review game based on the \"Memory game\"",
  "image": "/images/games/memory/icon.png",
  "instructions": "Select a course and game settings",
  "courses": [
    "ap-biology",
    "ap-art-history",
    "ap-world-history"
  ],
  "options": [
    {
      "key": "identifier",
      "displayKey": "Identifier",
      "values": ["term", "termImage"],
      "multiselect": false
    },
    {
      "key": "info",
      "displayKey": "Card information",
      "values": ["text", "image"],
      "multiselect": false
    }
  ],
  "settings": [
    {
        "key": "player",
        "displayKey": "Players",
        "values": ["1","2","3"],
        "displayValues": ["Singleplayer", "Two players", "Three players"],
        "multiselect": false
    },
    {
        "key": "size",
        "displayKey": "Board size",
        "values": ["10","15","21"],
        "displayValues": ["Small", "Medium", "Large"],
        "multiselect": false
    },
    {
        "key": "mode",
        "displayKey": "Difficulty",
        "values": ["easy", "medium", "hard"],
        "displayValues": ["Easy (all cards face up)", "Medium (half of cards face up)", "Hard (all cards face down)"],
        "multiselect": false
    }
]
}